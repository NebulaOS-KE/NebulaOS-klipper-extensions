{
  "compat_schema_version": 1,
  "extensions_version": "0.9.0",
  "nebulaos_api_level": 1,

  "required_klipper_symbols": [
    "mcu:MCU.register_serial_response",
    "mcu:MCU.create_oid",
    "mcu:MCU.register_config_callback",
    "mcu:MCU.add_config_cmd",
    "mcu:MCU.lookup_command",
    "mcu:MCU.lookup_query_command",
    "mcu:MCU.get_constants",
    "extras.heaters:PrinterHeaters.add_sensor_factory",
    "extras.heaters:PrinterHeaters.setup_sensor",
    "extras.temperature_mcu:PrinterTemperatureMCU.config_unknown",
    "extras.temperature_mcu:PrinterTemperatureMCU.calc_base",
    "extras.temperature_mcu:PrinterTemperatureMCU.handle_mcu_identify",
    "toolhead:ToolHead.get_kinematics",
    "toolhead:ToolHead.get_position",
    "toolhead:ToolHead.set_position",
    "toolhead:ToolHead.wait_moves",
    "extras.aio_executor:Dispatcher.allocate_executor",
    "extras.aio_executor:Executor.submit",
    "gcode:GCodeDispatch.register_command",
    "gcode:GCodeDispatch.run_script_from_command",
    "pins:PrinterPins.setup_pin"
  ],

  "forbidden_klipper_symbols": [],

  "composition": {
    "source_dir": "extras",
    "destination_dir": "klippy/extras",
    "exclude_file": ".git/info/exclude",
    "link_type": "symlink",
    "marker_file": ".nebulaos-composed",
    "require_symlink_resolving_inside_source": true
  },

  "modules": [
    {"path": "extras/prtouch_test_support.py", "role": "runtime"},
    {"path": "extras/z_compensate.py", "role": "runtime"},
    {"path": "extras/tmcstatus.py", "role": "runtime"},
