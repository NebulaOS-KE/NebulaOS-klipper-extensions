    {"path": "extras/nebulaos_calibration_journal.py", "role": "runtime"},
    {"path": "extras/nebulaos_memory.py", "role": "runtime"},

    {"path": "extras/test_nebulaos_compat.py", "role": "test"},
    {"path": "extras/test_nebulaos_plr_journal.py", "role": "test"},
    {"path": "extras/test_nebulaos_power_loss_recovery.py", "role": "test"},
    {"path": "extras/test_nebulaos_temperature_mcu.py", "role": "test"},
